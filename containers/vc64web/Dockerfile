# VirtualC64 headless + control API. It contains the ALREADY built headless page (c64-headless.html) and the portable page (VirtualC64-vNN.html), generated by build.py
# and only the files needed at run time (list in .dockerignore: allowlist). No portable/, build.py, changelog, etc.
# Do not run by hand: `python3 build.py` generates the pages and then builds the image, passing the pages folder as the
# context named "pages" (--build-context pages=DIR: so the --out output can also live outside this folder).
# Optional CA for a TLS-intercepting proxy (only during npm/playwright): --secret id=ca,src=FILE (build.py: C64_CA_BUNDLE).
# Copyright © 2026 Simone Caporale
FROM node:22-bookworm-slim
# (15/11) the daemon runs Chromium headless (c64d.js), which Playwright serves with chromium-headless-shell: only that one is
# installed (-393 MB). HEADED=1 installs the full Chromium too, needed only by the debug mode with a window (C64_HEADED=1 +
# DISPLAY). Videos do not need it: frames are captured inside the page and encoded by the system ffmpeg (libx264).
ARG HEADED=0
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_PATH=/usr/local/lib/node_modules \
    C64_HOST=0.0.0.0 C64_NO_SANDBOX=1 \
    C64_ROMS=/roms C64_GAMES=/games
# external dependencies: ffmpeg (video) and Playwright + Chromium (used only internally by the daemon). Playwright's own ffmpeg
# (its recordVideo, not used) is removed.
RUN --mount=type=secret,id=ca \
    if [ -s /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    apt-get update && apt-get install -y --no-install-recommends ffmpeg \
 && npm i -g playwright@1.63.0 \
 && if [ "$HEADED" = 1 ]; then npx playwright install --with-deps chromium; else npx playwright install --with-deps --only-shell chromium; fi \
 && rm -rf /var/lib/apt/lists/* /root/.npm /root/.cache /ms-playwright/ffmpeg-* /usr/share/man/* \
 && find /usr/share/doc \( -type f -o -type l \) ! -name copyright -delete \
 && find /usr/share/doc -mindepth 1 -type d -empty -delete
WORKDIR /app
COPY --from=pages c64-headless.html /app/out/c64-headless.html
# (1.10) the portable page (single HTML, all ROM variants) is in the image too: the viewer shows and offers it (c64d: GET /pages/)
COPY --from=pages VirtualC64-v*.html /app/out/
COPY headless/ /app/headless/
COPY docs/ /app/docs/
# (16/11) the ROMs come from Lab64's roms/ folder as the build context "roms" (the only place where the user keeps them)
COPY --from=roms . /app/roms/
RUN mkdir -p /games /roms /scripts /output
# /games = game files (.d64 .g64 .prg .t64 .crt ...) ; /roms = extra ROMs ; /scripts = input scripts ; /output = produced files (screenshots, videos, recordings)
VOLUME ["/games", "/roms", "/scripts", "/output"]
EXPOSE 7064
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "require('http').get('http://127.0.0.1:7064/ping',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "headless/c64d.js", "--port", "7064"]
