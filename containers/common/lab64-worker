]


if __name__ == "__main__":
    a = sys.argv[1:]
    cmds = {"init": init, "build": build, "publish": publish, "test": test, "manual": manual, "map": memmap}
    if not a or a[0] not in cmds:
        sys.exit(__doc__ if not a or a[0] in ("help", "-h", "--help") else
                 "lab64 %s: a host command (run it on the host, not in a Lab64 container)\n" % a[0] + __doc__)
    cmds[a[0]](a[1:])
